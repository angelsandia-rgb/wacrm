# /root/sandia-backup/backup.env  (chmod 600, owner root)
# Host: Supabase -> Project Settings -> Database -> Connection string ->
# "Session pooler". Password: generated on the VPS for the sandia_backup
# role (see RUNBOOK §9 — only its SCRAM verifier goes to the database).
# Session mode (port 5432) is required: pg_dump does not work through the
# transaction pooler (6543), and the direct db.<ref>.supabase.co host is IPv6-only.
PGHOST=aws-0-us-west-2.pooler.supabase.com
PGPORT=5432
# Dedicated read-only role (migration 157), not the postgres superuser.
PGUSER=sandia_backup.puvbwzwmojpjplhdfnmk
PGDATABASE=postgres
PGPASSWORD=
# Off-site copy to Cloudflare R2 (RUNBOOK §9). Leave R2_ACCOUNT_ID empty to skip.
# Token: R2 -> Manage API Tokens -> Object Read & Write on the bucket only.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Client-side encryption key, generated on the VPS (openssl rand -base64 32).
# ALSO store it outside the VPS (password manager): without it the R2 copy
# cannot be decrypted.
R2_CRYPT_PASSWORD=
# R2_BUCKET=sandia-backups
# R2_DB_RETENTION_DAYS=30
# Optional overrides:
# BACKUP_DIR=/var/backups/sandia
# RETENTION_DAYS=14
